      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "_comment": "# PromQL generated by Codex (gpt-6.1-sol) from prompt: \"All-TC replay MAE compared with previous champion and D30 limit of 1.04 \\u00d7 reference MAE.\"",
          "expr": "elo_batch_mae{tc=\"all\"}",
          "legendFormat": "{{model}}",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "_comment": "# PromQL generated by Codex (gpt-6.1-sol) from prompt: \"All-TC replay MAE compared with previous champion and D30 limit of 1.04 \\u00d7 reference MAE.\"",
          "expr": "1.04 * elo_reference_mae",
          "legendFormat": "D30 limit (1.04 \u00d7 reference)",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#009E73",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "previous_champion"
