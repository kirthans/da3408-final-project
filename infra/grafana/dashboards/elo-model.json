{
  "uid": "elo-model",
  "title": "Model quality, drift and pipeline",
  "description": "D30 quality gates, drift disclosure, registry changes and retraining telemetry.",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "tags": [
    "elo",
    "provisioned"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Current replay month",
      "description": "Last revealed replay month, encoded YYYYMM; 0 means no reveal yet.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "_comment": "# PromQL generated by Codex (gpt-6.1-sol) from prompt: \"Last revealed replay month, encoded YYYYMM; 0 means no reveal yet.\" Default to zero before the first sample.",
          "expr": "(elo_replay_month) or on() vector(0)",
          "legendFormat": "YYYYMM",
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#009E73",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 2,
      "title": "Champion and previous champion MAE",
      "description": "All-TC replay MAE compared with previous champion and D30 limit of 1.04 \u00d7 reference MAE.",
