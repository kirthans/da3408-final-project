        {
          "refId": "A",
          "_comment": "# PromQL generated by Codex (gpt-6.1-sol) from prompt: \"Five-minute server-error fraction; denominator is at least 0.001 requests/second.\"",
          "expr": "(sum(rate(elo_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(elo_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
