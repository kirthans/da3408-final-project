{
  "uid": "elo-service",
  "title": "Service health",
  "description": "API, model server and host telemetry; all seven scrape jobs are visible.",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "tags": [
    "elo",
    "provisioned"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health \u2014 all seven jobs",
      "description": "1 means scrape succeeded; monitor/trainer may be absent until M7 is running.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "_comment": "# PromQL generated by Codex (gpt-6.1-sol) from prompt: \"1 means scrape succeeded; monitor/trainer may be absent until M7 is running.\" Default to zero before the first sample.",
          "expr": "(up) or on() vector(0)",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#009E73",
                "value": null
              },
              {
                "color": "#D55E00",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#D55E00"
                },
                "1": {
                  "text": "UP",
                  "color": "#009E73"
                }
              }
            }
          ],
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 2,
