    {
      "id": 4,
      "title": "API 5xx ratio",
      "description": "Five-minute server-error fraction; denominator is at least 0.001 requests/second.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
